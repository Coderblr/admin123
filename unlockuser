"use client";

import { useState } from "react";

export default function UnlockUserView() {

  const [username, setUsername] = useState("");
  const [response, setResponse] = useState(null);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

  const handleUnlock = async () => {

    if (!username.trim()) {
      setError("Username is required");
      return;
    }

    setLoading(true);
    setError("");
    setResponse(null);

    try {

      const res = await fetch(
        `${BASE_URL}/admin/users/${username}/unlock`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json"
          }
        }
      );

      const data = await res.json();

      if (!res.ok) {
        setError(data.detail || "Failed to unlock account");
        return;
      }

      setResponse(data);

    } catch (err) {
      setError("Server connection failed");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={pageWrapper}>

      {/* CARD */}
      <div style={card}>

        <h2 style={title}>Unlock User Account</h2>
        <p style={subtitle}>
          Unlock a user account by resetting failed login attempts.
        </p>

        <div style={field}>
          <label style={label}>Username</label>
          <input
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            placeholder="Enter username"
            style={input}
          />
        </div>

        <button
          onClick={handleUnlock}
          disabled={loading}
          style={button}
        >
          {loading ? "Unlocking..." : "Unlock Account"}
        </button>

      </div>

      {/* SUCCESS */}

      {response && (
        <div style={successCard}>

          <h3 style={{ marginBottom: "15px" }}>
            Account Unlocked Successfully
          </h3>

          <table style={table}>
            <tbody>

              <Row label="Username" value={response.username} />
              <Row label="Status" value="Unlocked" />

            </tbody>
          </table>

          <p style={{ marginTop: "15px" }}>
            {response.message}
          </p>

        </div>
      )}

      {/* ERROR */}

      {error && (
        <div style={errorBox}>
          {typeof error === "string" ? error : JSON.stringify(error)}
        </div>
      )}

    </div>
  );
}


/* Reusable Row */
function Row({ label, value }) {
  return (
    <tr>
      <td style={tdLabel}>{label}</td>
      <td style={tdValue}>{value}</td>
    </tr>
  );
}


