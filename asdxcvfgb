const BASE_URL = process.env.NEXT_PUBLIC_API_URL || "";

async function callApi(endpoint, body) {
    const res = await fetch(`${BASE_URL}${endpoint}`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data?.detail || `API error: ${res.status}`);
    return data;
}

const STEPS = [
    { key: "limit",            label: "Limit Creation",     num: 2 },
    { key: "additional",       label: "Additional Details", num: 3 },
    { key: "referral",         label: "Referral",           num: 4 },
    { key: "acknowledgement",  label: "Acknowledgement",    num: 5 },
    { key: "approval",         label: "Limit Approval",     num: 6 },
    { key: "acceptance",       label: "User Acceptance",    num: 7 },
    { key: "referralApproval", label: "Referral Approval",  num: 8 },
    { key: "accClose",         label: "Account Close",      num: 9 },
];

// Done only when there is a SUCCESS response (not an error)
function stepIsDone(workflow, key) {
    const v = workflow[key];
    if (!v) return false;
    if (v.__isError) return false;
    return true;
}

// All steps are unlocked — users can perform any step in any order
function stepIsUnlocked(workflow, key) {
    return true;
}

