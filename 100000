<button
  type="submit"
  style={{
    ...styles.primaryButton,
    transform: isLoading ? "scale(0.95)" : "scale(1)",
    opacity: isLoading ? 0.7 : 1,
    cursor: isLoading ? "not-allowed" : "pointer",
    transition: "all 0.2s ease"
  }}
  disabled={isLoading}
>
  {isLoading ? "Fetching..." : "Fetch Account Details"}
</button>