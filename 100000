# services/excel_understanding.py

import pandas as pd
import json
import re

class ExcelSchemaUnderstanding:

    def __init__(self, file_path):

        self.file_path = file_path
        self.excel_data = None

        self.tables = {}
        self.relationships = []
        self.primary_keys = {}
        self.foreign_keys = {}

    # =====================================================
    # READ EXCEL
    # =====================================================

    def read_excel(self):

        self.excel_data = pd.read_excel(self.file_path)

        self.excel_data.columns = [
            col.strip().upper()
            for col in self.excel_data.columns
        ]

        return self.excel_data

    # =====================================================
    # DETECT TABLES
    # =====================================================

    def detect_tables(self):

        for _, row in self.excel_data.iterrows():

            table_name = str(row["TABLE_NAME"]).strip()

            if table_name not in self.tables:
                self.tables[table_name] = []

            self.tables[table_name].append({
                "column_name": str(row["COLUMN_NAME"]).strip(),
                "datatype": str(row["DATATYPE"]).strip(),
                "primary_key": str(
                    row.get("PRIMARY_KEY", "NO")
                ).strip(),

                "foreign_key": str(
                    row.get("FOREIGN_KEY", "NO")
                ).strip(),

                "references": str(
                    row.get("REFERENCES", "")
                ).strip()
            })

        return self.tables

    # =====================================================
    # DETECT PRIMARY KEYS
    # =====================================================

    def detect_primary_keys(self):

        for table, columns in self.tables.items():

            self.primary_keys[table] = []

            for column in columns:

                if column["primary_key"].upper() == "YES":

                    self.primary_keys[table].append(
                        column["column_name"]
                    )

        return self.primary_keys

    # =====================================================
    # DETECT FOREIGN KEYS
    # =====================================================

    def detect_foreign_keys(self):

        for table, columns in self.tables.items():

            self.foreign_keys[table] = []

            for column in columns:

                if column["foreign_key"].upper() == "YES":

                    self.foreign_keys[table].append({
                        "column": column["column_name"],
                        "references": column["references"]
                    })

        return self.foreign_keys

    # =====================================================
    # BUILD RELATIONSHIPS
    # =====================================================

    def build_relationships(self):

        for table, columns in self.tables.items():

            for column in columns:

                if column["foreign_key"].upper() == "YES":

                    reference = column["references"]

                    if "." in reference:

                        target_table = reference.split(".")[0]
                        target_column = reference.split(".")[1]

                    else:

                        target_table = reference
                        target_column = ""

                    self.relationships.append({
                        "source_table": table,
                        "source_column": column["column_name"],
                        "target_table": target_table,
                        "target_column": target_column
                    })

        return self.relationships

    # =====================================================
    # DETECT COMMON IDS
    # =====================================================

    def detect_common_columns(self):

        common_columns = {}

        all_columns = {}

        for table, columns in self.tables.items():

            for column in columns:

                column_name = column["column_name"]

                if column_name not in all_columns:
                    all_columns[column_name] = []

                all_columns[column_name].append(table)

        for column, tables in all_columns.items():

            if len(tables) > 1:

                common_columns[column] = tables

        return common_columns

    # =====================================================
    # UNDERSTAND BUSINESS MEANING
    # =====================================================

    def understand_schema(self):

        understanding = {}

        for table in self.tables:

            if "ACCOUNT" in table.upper():

                understanding[table] = \
                    "Contains account related data"

            elif "SECURITY" in table.upper():

                understanding[table] = \
                    "Contains collateral/security details"

            elif "BRWR" in table.upper():

                understanding[table] = \
                    "Contains borrower and guarantor mapping"

            elif "LOS" in table.upper():

                understanding[table] = \
                    "Contains Loan Origination System data"

            elif "LMS" in table.upper():

                understanding[table] = \
                    "Contains Loan Management System data"

            else:

                understanding[table] = \
                    "General business table"

        return understanding

    # =====================================================
    # GENERATE COMPLETE METADATA
    # =====================================================

    def generate_metadata(self):

        metadata = {
            "tables": self.tables,
            "primary_keys": self.primary_keys,
            "foreign_keys": self.foreign_keys,
            "relationships": self.relationships,
            "common_columns": self.detect_common_columns(),
            "business_understanding": self.understand_schema()
        }

        return metadata

    # =====================================================
    # GENERATE LLM CONTEXT
    # =====================================================

    def generate_llm_context(self):

        metadata = self.generate_metadata()

        context = f"""
        DATABASE SCHEMA UNDERSTANDING

        TABLES:
        {json.dumps(metadata['tables'], indent=2)}

        PRIMARY KEYS:
        {json.dumps(metadata['primary_keys'], indent=2)}

        FOREIGN KEYS:
        {json.dumps(metadata['foreign_keys'], indent=2)}

        RELATIONSHIPS:
        {json.dumps(metadata['relationships'], indent=2)}

        COMMON COLUMNS:
        {json.dumps(metadata['common_columns'], indent=2)}

        BUSINESS UNDERSTANDING:
        {json.dumps(metadata['business_understanding'], indent=2)}
        """

        return context

    # =====================================================
    # RUN EVERYTHING
    # =====================================================

    def analyze(self):

        self.read_excel()

        self.detect_tables()

        self.detect_primary_keys()

        self.detect_foreign_keys()

        self.build_relationships()

        metadata = self.generate_metadata()

        llm_context = self.generate_llm_context()

        return {
            "metadata": metadata,
            "llm_context": llm_context
        }