import os
import re
from datetime import datetime

import openpyxl

from openpyxl.styles import (
    Font,
    PatternFill,
    Alignment
)

from generators.base_generator import generate_table_records
from generators.table_registry import TABLE_REGISTRY


class DataOrchestrator:

    def __init__(self, upload_dir: str, output_dir: str):

        self.upload_dir = upload_dir
        self.output_dir = output_dir

    # ==========================================================
    # MAIN PROCESS
    # ==========================================================

    def process(
        self,
        filename: str,
        num_records: int
    ) -> str:

        file_path = os.path.join(
            self.upload_dir,
            filename
        )

        table_schemas = self._parse_input_file(
            file_path
        )

        if not table_schemas:

            raise ValueError(
                f"No schemas found in file: {filename}"
            )

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        output_filename = (
            f"generated_{timestamp}.xlsx"
        )

        output_path = os.path.join(
            self.output_dir,
            output_filename
        )

        # ======================================
        # CREATE WORKBOOK
        # ======================================

        wb = openpyxl.Workbook()

        wb.remove(wb.active)

        # ======================================
        # PROCESS EACH TABLE
        # ======================================

        for table_name, columns in table_schemas.items():

            print(
                f"[INFO] Generating {num_records} "
                f"records for table: {table_name}"
            )

            schema_columns = TABLE_REGISTRY.get(
                table_name,
                columns
            )

            records = generate_table_records(
                table_name,
                schema_columns,
                num_records
            )

            if not records:

                print(
                    f"[WARN] No records generated "
                    f"for {table_name}"
                )

                records = []

            self._write_sheet(
                wb,
                table_name,
                schema_columns,
                records
            )

        wb.save(output_path)

        print(
            f"[INFO] Output saved: {output_path}"
        )

        return output_filename

    # ==========================================================
    # PARSE INPUT FILE
    # ==========================================================

    def _parse_input_file(
        self,
        file_path: str
    ):

        ext = os.path.splitext(
            file_path
        )[1].lower()

        if ext in [".xlsx", ".xls"]:

            lines = self._read_excel_lines(
                file_path
            )

        else:

            with open(
                file_path,
                "r",
                encoding="utf-8"
            ) as f:

                lines = f.read().splitlines()

        return self._extract_schemas(lines)

    # ==========================================================
    # READ EXCEL
    # ==========================================================

    def _read_excel_lines(
        self,
        file_path: str
    ):

        wb = openpyxl.load_workbook(
            file_path
        )

        lines = []

        for ws in wb.worksheets:

            for row in ws.iter_rows(
                values_only=True
            ):

                parts = []

                for cell in row:

                    if cell is not None:

                        value = str(cell).strip()

                        if value:
                            parts.append(value)

                if parts:

                    line = " ~ ".join(parts)

                    lines.append(line)

        return lines

    # ==========================================================
    # EXTRACT SCHEMAS
    # ==========================================================

    def _extract_schemas(
        self,
        lines
    ):

        schemas = {}

        pattern = re.compile(
            r"^\s*([A-Z0-9_]+)\s*~\s*([A-Z0-9_]+)\s*~\s*([A-Z0-9(),\s]+)\s*$",
            re.IGNORECASE
        )

        for line in lines:

            line = (
                line.strip()
                .strip('"')
                .strip("'")
            )

            match = pattern.match(line)

            if not match:
                continue

            table_name = (
                match.group(1)
                .strip()
                .upper()
            )

            col_name = (
                match.group(2)
                .strip()
                .upper()
            )

            col_type = (
                match.group(3)
                .strip()
                .upper()
            )

            schemas.setdefault(
                table_name,
                []
            )

            schemas[table_name].append({
                "name": col_name,
                "type": col_type
            })

        return schemas

    # ==========================================================
    # WRITE EXCEL SHEET
    # ==========================================================

    def _write_sheet(
        self,
        wb,
        table_name,
        columns,
        records
    ):

        sheet_name = (
            table_name[:31]
            if len(table_name) > 31
            else table_name
        )

        ws = wb.create_sheet(
            title=sheet_name
        )

        # ======================================
        # HEADER STYLE
        # ======================================

        header_fill = PatternFill(
            "solid",
            fgColor="1F4E79"
        )

        header_font = Font(
            bold=True,
            color="FFFFFF",
            size=11
        )

        alt_fill = PatternFill(
            "solid",
            fgColor="EBF3FB"
        )

        # ======================================
        # COLUMN NAMES
        # ======================================

        col_names = [
            col["name"]
            for col in columns
        ]

        # ======================================
        # WRITE HEADER
        # ======================================

        for c_idx, col_name in enumerate(
            col_names,
            start=1
        ):

            cell = ws.cell(
                row=1,
                column=c_idx,
                value=str(col_name)
            )

            cell.font = header_font
            cell.fill = header_fill

            cell.alignment = Alignment(
                horizontal="center",
                vertical="center"
            )

        # ======================================
        # WRITE DATA
        # ======================================

        for r_idx, record in enumerate(
            records,
            start=2
        ):

            # VERY IMPORTANT FIX
            if not isinstance(record, dict):
                continue

            for c_idx, col_name in enumerate(
                col_names,
                start=1
            ):

                value = record.get(
                    col_name,
                    ""
                )

                # ==================================
                # FIX EXCEL DICT ERROR
                # ==================================

                if isinstance(value, dict):

                    value = str(value)

                elif isinstance(value, list):

                    value = ", ".join(
                        map(str, value)
                    )

                elif value is None:

                    value = ""

                else:

                    value = str(value)

                cell = ws.cell(
                    row=r_idx,
                    column=c_idx,
                    value=value
                )

                cell.alignment = Alignment(
                    vertical="center"
                )

                if r_idx % 2 == 0:
                    cell.fill = alt_fill

        # ======================================
        # AUTO WIDTH
        # ======================================

        for col_cells in ws.columns:

            max_len = max(
                (
                    len(str(cell.value))
                    for cell in col_cells
                    if cell.value
                ),
                default=10
            )

            ws.column_dimensions[
                col_cells[0].column_letter
            ].width = min(
                max_len + 4,
                50
            )

        # ======================================
        # FREEZE HEADER
        # ======================================

        ws.freeze_panes = "A2"

        print(
            f"[INFO] Sheet '{sheet_name}' "
            f"written successfully."
        )