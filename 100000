"use client";

import { useState } from "react";
import { styles } from "../../styles/AppStyles";
import RegionDropdown from "../../utils/RegionDropdown";
import accCreationService from "../../services/accCreationService";

// ======================================
// HELPERS
// ======================================

const isOnlyDigits = (value) => /^\d*$/.test(value);

// ======================================
// PRODUCT OPTIONS
// ======================================

const PRODUCT_OPTIONS = [

    { value: "SBGEN", label: "Savings General" },

    { value: "SBSA", label: "Savings Salary" },

    { value: "CURRENT", label: "Current Account" },

    { value: "FD", label: "Fixed Deposit" },

    { value: "RD", label: "Recurring Deposit" },

    { value: "PPF", label: "PPF Account" },

    { value: "NRE", label: "NRE Account" },

    { value: "NRO", label: "NRO Account" },

    { value: "CC", label: "Cash Credit" },

    { value: "OD", label: "Over Draft" }

];

// ======================================
// COMPONENT
// ======================================

export default function AccountCreationView() {

    // ==================================
    // STATES
    // ==================================

    const [server, setServer] = useState("K");

    const [cif, setCif] = useState("");

    const [product, setProduct] = useState("SBGEN");

    const [count, setCount] = useState("1");

    const [loading, setLoading] = useState(false);

    const [error, setError] = useState("");

    const [result, setResult] = useState(null);

    // ==================================
    // SUBMIT
    // ==================================

    const handleSubmit = async () => {

        setError("");

        setResult(null);

        // ===============================
        // CIF VALIDATION
        // ===============================

        if (!/^\d{11}$/.test(cif)) {

            setError(
                "CIF must be exactly 11 digits"
            );

            return;
        }

        // ===============================
        // COUNT VALIDATION
        // ===============================

        if (!/^\d+$/.test(count)) {

            setError(
                "Count must be numeric"
            );

            return;
        }

        const total = Number(count);

        if (total < 1 || total > 100) {

            setError(
                "Count must be between 1 and 100"
            );

            return;
        }

        // ===============================
        // API CALL
        // ===============================

        try {

            setLoading(true);

            const response =
                await accCreationService.acc_creation({

                    server: server,

                    cif: cif,

                    product: product,

                    n: total

                });

            console.log(
                "FULL RESPONSE:",
                response
            );

            setResult(response);

        } catch (err) {

            console.error(err);

            setError(

                err?.response?.data?.detail ||

                "Account creation failed"

            );

        } finally {

            setLoading(false);

        }
    };

    // ==================================
    // UI
    // ==================================

    return (

        <div>

            {/* ========================== */}
            {/* PAGE HEADER */}
            {/* ========================== */}

            <div style={styles.pageHeader}>

                <h1 style={styles.pageTitle}>
                    Account Creation
                </h1>

            </div>

            {/* ========================== */}
            {/* ERROR */}
            {/* ========================== */}

            {error && (

                <div style={styles.fieldError}>
                    {error}
                </div>

            )}

            {/* ========================== */}
            {/* FORM CARD */}
            {/* ========================== */}

            <div style={styles.formCard}>

                <div style={styles.formGrid}>

                    {/* SERVER */}

                    <RegionDropdown
                        value={server}
                        onChange={setServer}
                    />

                    {/* CIF */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            CIF Number
                        </label>

                        <input
                            type="text"
                            style={styles.input}
                            placeholder="Enter 11 digit CIF"
                            value={cif}
                            onChange={(e) => {

                                const val =
                                    e.target.value;

                                if (
                                    isOnlyDigits(val) &&
                                    val.length <= 11
                                ) {

                                    setCif(val);

                                }
                            }}
                        />

                    </div>

                    {/* PRODUCT */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            Product Type
                        </label>

                        <select
                            style={styles.select}
                            value={product}
                            onChange={(e) =>
                                setProduct(
                                    e.target.value
                                )
                            }
                        >

                            {PRODUCT_OPTIONS.map(
                                (item) => (

                                    <option
                                        key={item.value}
                                        value={item.value}
                                    >

                                        {item.label}

                                    </option>

                                )
                            )}

                        </select>

                    </div>

                    {/* COUNT */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            Number Of Accounts
                        </label>

                        <input
                            type="text"
                            style={styles.input}
                            placeholder="1 to 100"
                            value={count}
                            onChange={(e) => {

                                const val =
                                    e.target.value;

                                if (
                                    isOnlyDigits(val) &&
                                    val.length <= 3
                                ) {

                                    setCount(val);

                                }
                            }}
                        />

                    </div>

                </div>

                {/* ====================== */}
                {/* BUTTON */}
                {/* ====================== */}

                <div style={{ marginTop: "24px" }}>

                    <button
                        style={styles.primaryButton}
                        onClick={handleSubmit}
                        disabled={loading}
                    >

                        {loading
                            ? "Processing..."
                            : "Create Account"}

                    </button>

                </div>

            </div>

            {/* ========================== */}
            {/* RESPONSE */}
            {/* ========================== */}

            {result?.results && (

                <div style={styles.resultsCard}>

                    <h3 style={{
                        marginBottom: "20px"
                    }}>
                        Account Creation Response
                    </h3>

                    <div style={styles.resultsList}>

                        {result.results.map(
                            (item, index) => (

                                <div
                                    key={index}
                                    style={styles.resultItem}
                                >

                                    <div
                                        style={
                                            styles.resultContent
                                        }
                                    >

                                        {/* ATTEMPT */}

                                        <p>

                                            <strong>
                                                ATTEMPT :
                                            </strong>{" "}

                                            {item.attempt}

                                        </p>

                                        {/* SUCCESS */}

                                        {item.parsed ? (

                                            Object.entries(
                                                item.parsed
                                            )

                                                .filter(
                                                    ([key, value]) =>

                                                        value !== null &&
                                                        value !== ""

                                                )

                                                .map(
                                                    ([key, value]) => (

                                                        <p key={key}>

                                                            <strong>

                                                                {key
                                                                    .replaceAll("_", " ")
                                                                    .toUpperCase()}

                                                                :

                                                            </strong>{" "}

                                                            {String(value)}

                                                        </p>

                                                    )
                                                )

                                        ) : (

                                            <p
                                                style={{
                                                    color: "red"
                                                }}
                                            >

                                                <strong>
                                                    ERROR :
                                                </strong>{" "}

                                                {item.error}

                                            </p>

                                        )}

                                    </div>

                                </div>

                            )
                        )}

                    </div>

                </div>

            )}

        </div>
    );
}