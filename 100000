"use client";

import { useState } from "react";
import { styles } from "../../styles/AppStyles";
import accCreationService from "../../services/accCreationService";
import RegionDropdown from "../../utils/RegionDropdown";

const isOnlyDigits = (value) => /^\d*$/.test(value);
const isAlphaNumeric = (value) => /^[A-Za-z0-9]*$/.test(value);

export default function AccountCreationView() {

    const [server, setServer] = useState("K");

    const [cif, setCif] = useState("");
    const [product, setProduct] = useState("");
    const [n, setN] = useState("1");

    const [loading, setLoading] = useState(false);

    const [error, setError] = useState("");

    const [result, setResult] = useState(null);

    // =========================
    // HANDLE SUBMIT
    // =========================

    const handleSubmit = async () => {

        setError("");
        setResult(null);

        // CIF Validation
        if (!/^\d{11}$/.test(cif)) {
            setError("CIF must be exactly 11 digits");
            return;
        }

        // PRODUCT Validation
        if (!isAlphaNumeric(product)) {
            setError("Product must be alphanumeric only");
            return;
        }

        if (product.length < 2 || product.length > 10) {
            setError("Product length must be between 2 and 10");
            return;
        }

        // N Validation
        if (!/^\d+$/.test(n)) {
            setError("Count must be numeric");
            return;
        }

        const total = Number(n);

        if (total < 1 || total > 100) {
            setError("Count must be between 1 and 100");
            return;
        }

        try {

            setLoading(true);

            const response = await accCreationService.create({

                server,
                cif,
                product,
                n: total

            });

            console.log("API RESPONSE:", response);

            setResult(response);

        } catch (err) {

            console.error(err);

            setError(
                err?.response?.data?.detail ||
                "Account creation failed"
            );

        } finally {

            setLoading(false);

        }
    };

    return (

        <div>

            {/* PAGE HEADER */}

            <div style={styles.pageHeader}>
                <h1 style={styles.pageTitle}>
                    Account Creation
                </h1>
            </div>

            {/* ERROR */}

            {error && (
                <div style={styles.fieldError}>
                    {error}
                </div>
            )}

            {/* FORM CARD */}

            <div style={styles.formCard}>

                <div style={styles.formGrid}>

                    {/* SERVER */}

                    <RegionDropdown
                        value={server}
                        onChange={setServer}
                    />

                    {/* CIF */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            CIF Number
                        </label>

                        <input
                            style={styles.input}
                            placeholder="11 digit CIF"
                            value={cif}
                            onChange={(e) => {

                                const val = e.target.value;

                                if (
                                    isOnlyDigits(val) &&
                                    val.length <= 11
                                ) {
                                    setCif(val);
                                }
                            }}
                        />

                    </div>

                    {/* PRODUCT */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            Product Code
                        </label>

                        <input
                            style={styles.input}
                            placeholder="ex. SBGEN"
                            value={product}
                            onChange={(e) => {

                                const val = e.target.value.toUpperCase();

                                if (
                                    isAlphaNumeric(val) &&
                                    val.length <= 10
                                ) {
                                    setProduct(val);
                                }
                            }}
                        />

                    </div>

                    {/* COUNT */}

                    <div style={styles.formGroup}>

                        <label style={styles.label}>
                            Number Of Accounts
                        </label>

                        <input
                            style={styles.input}
                            placeholder="1 to 100"
                            value={n}
                            onChange={(e) => {

                                const val = e.target.value;

                                if (
                                    isOnlyDigits(val) &&
                                    val.length <= 3
                                ) {
                                    setN(val);
                                }
                            }}
                        />

                    </div>

                </div>

                {/* BUTTON */}

                <div style={{ marginTop: "24px" }}>

                    <button
                        onClick={handleSubmit}
                        style={styles.primaryButton}
                        disabled={loading}
                    >

                        {loading
                            ? "Processing..."
                            : "Create Account"}

                    </button>

                </div>

            </div>

            {/* RESPONSE */}

            {result?.results && (

                <div style={styles.resultsCard}>

                    <h3 style={{ marginBottom: "20px" }}>
                        Account Creation Response
                    </h3>

                    <div style={styles.resultsList}>

                        {result.results.map((item, index) => (

                            <div
                                key={index}
                                style={styles.resultItem}
                            >

                                <div style={styles.resultContent}>

                                    <p>
                                        <strong>
                                            ATTEMPT :
                                        </strong>{" "}
                                        {item.attempt}
                                    </p>

                                    {item.parsed ? (

                                        Object.entries(item.parsed)
                                            .filter(([key, value]) =>
                                                value !== null &&
                                                value !== ""
                                            )
                                            .map(([key, value]) => (

                                                <p key={key}>

                                                    <strong>
                                                        {key
                                                            .replaceAll("_", " ")
                                                            .toUpperCase()}
                                                        :
                                                    </strong>{" "}

                                                    {String(value)}

                                                </p>

                                            ))

                                    ) : (

                                        <p style={{ color: "red" }}>

                                            <strong>
                                                ERROR :
                                            </strong>{" "}

                                            {item.error}

                                        </p>

                                    )}

                                </div>

                            </div>

                        ))}

                    </div>

                </div>

            )}

        </div>
    );
}