"use client";

import { useState } from "react";

export default function AdminUserCreateView() {
  const departments = [
    { label: "IT-Trade Finance & SCF (171)", value: "171" },
    { label: "IT-Corporate & SME Loans (450)", value: "450" },
    { label: "IT-Retail Loans (382)", value: "382" },
  ];

  const userTypes = [
    { label: "Admin", value: "1" },
    { label: "User", value: "3" },
  ];

  const [form, setForm] = useState({
    username: "",
    firstName: "",
    lastName: "",
    departmentCode: "",
    userType: "",
    default_password: "",
  });

  const [error, setError] = useState({});
  const [loading, setLoading] = useState(false);
  const [response, setResponse] = useState(null);

  const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };

  const validateForm = () => {
    let newErrors = {};

    if (!/^[a-zA-Z0-9]{1,16}$/.test(form.username))
      newErrors.username = "Alphanumeric only (max 16 chars)";

    if (!/^[A-Za-z]{1,20}$/.test(form.firstName))
      newErrors.firstName = "Letters only (max 20)";

    if (!/^[A-Za-z]{1,20}$/.test(form.lastName))
      newErrors.lastName = "Letters only (max 20)";

    if (!form.departmentCode)
      newErrors.departmentCode = "Select department";

    if (!form.userType)
      newErrors.userType = "Select user type";

    if (form.default_password && form.default_password.length > 15)
      newErrors.default_password = "Max 15 characters allowed";

    setError(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async () => {
    if (!validateForm()) return;

    setLoading(true);
    setError({});
    setResponse(null);

    try {
      const res = await fetch(`${BASE_URL}/admin/users`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });

      const data = await res.json();

      if (!res.ok) {
        setError({ api: data.detail || "Failed to create user" });
        return;
      }

      setResponse(data);
    } catch {
      setError({ api: "Server connection failed" });
    } finally {
      setLoading(false);
    }
  };

  return (
    <>
      <div className="page">
        <div className="card">
          <h2>Create User</h2>
          <p className="subtitle">
            Create a system user and generate a temporary password
          </p>

          <div className="formGrid">
            <Input label="Username" name="username" value={form.username} onChange={handleChange} error={error.username} />

            <Input label="First Name" name="firstName" value={form.firstName} onChange={handleChange} error={error.firstName} />

            <Input label="Last Name" name="lastName" value={form.lastName} onChange={handleChange} error={error.lastName} />

            <div className="field">
              <label>Department</label>
              <select name="departmentCode" value={form.departmentCode} onChange={handleChange}>
                <option value="">Select Department</option>
                {departments.map((dep) => (
                  <option key={dep.value} value={dep.value}>{dep.label}</option>
                ))}
              </select>
              {error.departmentCode && <span className="error">{error.departmentCode}</span>}
            </div>

            <div className="field">
              <label>User Type</label>
              <select name="userType" value={form.userType} onChange={handleChange}>
                <option value="">Select User Type</option>
                {userTypes.map((type) => (
                  <option key={type.value} value={type.value}>{type.label}</option>
                ))}
              </select>
              {error.userType && <span className="error">{error.userType}</span>}
            </div>

            <Input label="Default Password (Optional)" name="default_password" value={form.default_password} onChange={handleChange} error={error.default_password} />
          </div>

          <button onClick={handleSubmit} disabled={loading} className="submitBtn">
            {loading ? "Creating..." : "Create User"}
          </button>

          {error.api && <div className="errorBox">{error.api}</div>}

          {response && (
            <div className="successBox">
              <h3>User Created Successfully</h3>
              <p><strong>Username:</strong> {response.username}</p>
              <p><strong>Password:</strong> {response.temporary_password}</p>
            </div>
          )}
        </div>
      </div>

      {/* ✅ INTERNAL CSS */}
      <style jsx>{`
        .page {
          padding: 40px;
          display: flex;
          justify-content: center;
          background: #f4f6f8;
          min-height: 100vh;
        }

        .card {
          width: 900px;
          background: #ffffff;
          padding: 30px 40px;
          border-radius: 12px;
          box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        h2 {
          margin-bottom: 5px;
          font-size: 24px;
          font-weight: 700;
        }

        .subtitle {
          color: #6b7280;
          font-size: 14px;
          margin-bottom: 25px;
        }

        .formGrid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 20px;
        }

        .field {
          display: flex;
          flex-direction: column;
        }

        label {
          font-size: 13px;
          font-weight: 600;
          margin-bottom: 6px;
        }

        input,
        select {
          padding: 10px;
          border-radius: 6px;
          border: 1px solid #cbd5e1;
          font-size: 14px;
        }

        input:focus,
        select:focus {
          border-color: #2563eb;
          outline: none;
        }

        .error {
          color: #ef4444;
          font-size: 12px;
          margin-top: 4px;
        }

        .submitBtn {
          margin-top: 30px;
          width: 100%;
          padding: 12px;
          background: #2563eb;
          color: white;
          border: none;
          border-radius: 8px;
          font-size: 15px;
          font-weight: 600;
          cursor: pointer;
        }

        .submitBtn:hover {
          background: #1e40af;
        }

        .errorBox {
          margin-top: 20px;
          padding: 12px;
          background: #fee2e2;
          border: 1px solid #ef4444;
          border-radius: 6px;
          color: #b91c1c;
        }

        .successBox {
          margin-top: 20px;
          padding: 15px;
          background: #dcfce7;
          border: 1px solid #22c55e;
          border-radius: 6px;
          color: #166534;
        }
      `}</style>
    </>
  );
}

// 🔹 Input Component
function Input({ label, name, value, onChange, error }) {
  return (
    <div className="field">
      <label>{label}</label>
      <input name={name} value={value} onChange={onChange} />
      {error && <span className="error">{error}</span>}
    </div>
  );
}