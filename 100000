const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

const fetchDashboardData = async () => {
  try {
    const [ctfRes, ccodRes, depositRes] = await Promise.all([
      fetch(`${BASE_URL}/ctf?userId=${user.id}`),
      fetch(`${BASE_URL}/ccod?userId=${user.id}`),
      fetch(`${BASE_URL}/deposits?userId=${user.id}`),
    ]);

    const ctfData = await ctfRes.json();
    const ccodData = await ccodRes.json();
    const depositData = await depositRes.json();

    setDashboardData({
      ctfCount: ctfData?.length || 0,
      ccodCount: ccodData?.length || 0,
      depositCount: depositData?.length || 0,
    });

  } catch (error) {
    console.error("Dashboard error:", error);
  }
};