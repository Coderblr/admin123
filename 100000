"use client";

import { useState } from "react";

const departments = [
  { label: "IT-Trade Finance & SCF (171)", value: "171" },
  { label: "IT-Corporate & SME Loans (450)", value: "450" },
  { label: "IT-Retail Loans (382)", value: "382" },
  { label: "IT-Agri Tech (462)", value: "462" },
  { label: "IT-Tech Operations Loans (476)", value: "476" },
  { label: "IT-Special Projects - Government (375)", value: "375" },
  { label: "IT-Special Projects - Audit & Websites (394)", value: "394" },
  { label: "IT-Regulatory Applications (475)", value: "475" },
  { label: "IT-JVS & Partnerships (488)", value: "488" },
];

const userTypes = [
  { label: "Admin", value: "1" },
  { label: "User", value: "3" },
];

export default function AdminUserCreateView() {
  const [form, setForm] = useState({
    username: "",
    firstName: "",
    lastName: "",
    departmentCode: "",
    userType: "",
    default_password: "",
  });

  const [response, setResponse] = useState(null);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [errors, setErrors] = useState({});

  const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

  // ✅ HANDLE CHANGE
  const handleChange = (e) => {
    const { name, value } = e.target;

    setForm({
      ...form,
      [name]: value,
    });

    // remove error on typing
    setErrors({
      ...errors,
      [name]: "",
    });
  };

  // ✅ VALIDATION
  const validateForm = () => {
    let newErrors = {};

    if (!form.username) {
      newErrors.username = "Username is required";
    } else if (form.username.length < 4) {
      newErrors.username = "Minimum 4 characters required";
    }

    if (!form.firstName) {
      newErrors.firstName = "First name is required";
    } else if (!/^[A-Za-z]+$/.test(form.firstName)) {
      newErrors.firstName = "Only alphabets allowed";
    }

    if (!form.lastName) {
      newErrors.lastName = "Last name is required";
    } else if (!/^[A-Za-z]+$/.test(form.lastName)) {
      newErrors.lastName = "Only alphabets allowed";
    }

    if (!form.departmentCode) {
      newErrors.departmentCode = "Please select department";
    }

    if (!form.userType) {
      newErrors.userType = "Please select user type";
    }

    if (form.default_password && form.default_password.length < 6) {
      newErrors.default_password = "Minimum 6 characters required";
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  // ✅ SUBMIT
  const handleSubmit = async () => {
    if (!validateForm()) return;

    setLoading(true);
    setError("");
    setResponse(null);

    try {
      const res = await fetch(`${BASE_URL}/admin/users/create`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });

      const data = await res.json();

      if (!res.ok) {
        setError(data.detail || "Unable to create user");
        return;
      }

      setResponse(data);
      setErrors({});
    } catch (err) {
      setError("Server connection failed");
    } finally {
      setLoading(false);
    }
  };

  // ✅ COPY PASSWORD
  const copyPassword = () => {
    navigator.clipboard.writeText(response?.temporary_password);
    alert("Temporary password copied");
  };

  return (
    <div style={pageWrapper}>
      <div style={card}>
        <h2>Create New User</h2>

        <div style={formGrid}>
          <Input label="Username" name="username" value={form.username} onChange={handleChange} error={errors.username} />
          <Input label="First Name" name="firstName" value={form.firstName} onChange={handleChange} error={errors.firstName} />
          <Input label="Last Name" name="lastName" value={form.lastName} onChange={handleChange} error={errors.lastName} />

          {/* Department */}
          <div style={field}>
            <label style={label}>Department</label>
            <select
              name="departmentCode"
              value={form.departmentCode}
              onChange={handleChange}
              style={{
                ...input,
                border: errors.departmentCode ? "1px solid red" : input.border,
              }}
            >
              <option value="">Select Department</option>
              {departments.map((dep) => (
                <option key={dep.value} value={dep.value}>
                  {dep.label}
                </option>
              ))}
            </select>
            {errors.departmentCode && <span style={errorText}>{errors.departmentCode}</span>}
          </div>

          {/* User Type */}
          <div style={field}>
            <label style={label}>User Type</label>
            <select
              name="userType"
              value={form.userType}
              onChange={handleChange}
              style={{
                ...input,
                border: errors.userType ? "1px solid red" : input.border,
              }}
            >
              <option value="">Select User Type</option>
              {userTypes.map((type) => (
                <option key={type.value} value={type.value}>
                  {type.label}
                </option>
              ))}
            </select>
            {errors.userType && <span style={errorText}>{errors.userType}</span>}
          </div>

          <Input
            label="Default Password (Optional)"
            name="default_password"
            value={form.default_password}
            onChange={handleChange}
            error={errors.default_password}
          />
        </div>

        <button onClick={handleSubmit} disabled={loading} style={button}>
          {loading ? "Creating..." : "Create User"}
        </button>
      </div>

      {/* SUCCESS */}
      {response && (
        <div style={successBox}>
          <h3>User Created Successfully</h3>
          <p>Username: {response.username}</p>
          <p>Password: {response.temporary_password}</p>
          <button onClick={copyPassword}>Copy Password</button>
        </div>
      )}

      {/* ERROR */}
      {error && <div style={errorBox}>{error}</div>}
    </div>
  );
}

/* ✅ INPUT COMPONENT */
function Input({ label: lbl, name, value, onChange, error }) {
  return (
    <div style={field}>
      <label style={label}>{lbl}</label>
      <input
        name={name}
        value={value}
        onChange={onChange}
        style={{
          ...input,
          border: error ? "1px solid red" : input.border,
        }}
      />
      {error && <span style={errorText}>{error}</span>}
    </div>
  );
}

/* ✅ STYLES */
const pageWrapper = { padding: "40px" };
const card = { background: "#fff", padding: "20px", borderRadius: "10px" };
const formGrid = { display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px" };
const field = { display: "flex", flexDirection: "column" };
const label = { marginBottom: "5px" };
const input = { padding: "10px", border: "1px solid #ccc", borderRadius: "5px" };
const button = { marginTop: "20px", padding: "10px 20px", background: "#2563eb", color: "#fff", border: "none" };
const errorText = { color: "red", fontSize: "12px", marginTop: "4px" };
const errorBox = { marginTop: "20px", color: "red" };
const successBox = { marginTop: "20px", background: "#e6fffa", padding: "15px" };