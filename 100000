"use client";

import { useState } from "react";

export default function AdminUserCreateView() {

  const [form, setForm] = useState({
    username: "",
    firstName: "",
    lastName: "",
    departmentCode: "",
    userType: "",
    default_password: "",
  });

  const [error, setError] = useState({});
  const [loading, setLoading] = useState(false);
  const [response, setResponse] = useState(null);

  const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

  const departments = [
    { label: "IT-Trade Finance & SCF (171)", value: "171" },
    { label: "IT-Corporate & SME Loans (450)", value: "450" },
    { label: "IT-Retail Loans (382)", value: "382" },
  ];

  const userTypes = [
    { label: "Admin", value: "1" },
    { label: "User", value: "3" },
  ];

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };

  // ✅ VALIDATION
  const validateForm = () => {
    let newErrors = {};

    if (!/^[a-zA-Z0-9]{1,16}$/.test(form.username))
      newErrors.username = "Only letters & numbers (max 16)";

    if (!/^[A-Za-z]{1,20}$/.test(form.firstName))
      newErrors.firstName = "Only letters (max 20)";

    if (!/^[A-Za-z]{1,20}$/.test(form.lastName))
      newErrors.lastName = "Only letters (max 20)";

    if (!form.departmentCode)
      newErrors.departmentCode = "Select department";

    if (!form.userType)
      newErrors.userType = "Select user type";

    if (form.default_password && form.default_password.length > 15)
      newErrors.default_password = "Max 15 characters allowed";

    setError(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async () => {
    if (!validateForm()) return;

    setLoading(true);
    setError({});
    setResponse(null);

    try {
      const res = await fetch(`${BASE_URL}/admin/users`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });

      const data = await res.json();

      if (!res.ok) {
        setError({ api: data.detail || "Failed to create user" });
        return;
      }

      setResponse(data);

    } catch {
      setError({ api: "Server error" });
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={pageWrapper}>
      <div style={card}>

        <div style={cardHeader}>
          <h2 style={title}>Create User</h2>
          <p style={subtitle}>
            Create a system user and generate temporary credentials
          </p>
        </div>

        <div style={formGrid}>
          <Input label="Username" name="username" value={form.username} onChange={handleChange} error={error.username} />
          <Input label="First Name" name="firstName" value={form.firstName} onChange={handleChange} error={error.firstName} />
          <Input label="Last Name" name="lastName" value={form.lastName} onChange={handleChange} error={error.lastName} />

          <div style={field}>
            <label style={label}>Department</label>
            <select name="departmentCode" value={form.departmentCode} onChange={handleChange} style={input}>
              <option value="">Select Department</option>
              {departments.map((d) => (
                <option key={d.value} value={d.value}>{d.label}</option>
              ))}
            </select>
            {error.departmentCode && <span style={errorText}>{error.departmentCode}</span>}
          </div>

          <div style={field}>
            <label style={label}>User Type</label>
            <select name="userType" value={form.userType} onChange={handleChange} style={input}>
              <option value="">Select User Type</option>
              {userTypes.map((u) => (
                <option key={u.value} value={u.value}>{u.label}</option>
              ))}
            </select>
            {error.userType && <span style={errorText}>{error.userType}</span>}
          </div>

          <Input label="Default Password (Optional)" name="default_password" value={form.default_password} onChange={handleChange} error={error.default_password} />
        </div>

        <div style={buttonRow}>
          <button onClick={handleSubmit} disabled={loading} style={submitButton}>
            {loading ? "Creating..." : "Create User"}
          </button>
        </div>

        {error.api && <div style={errorBox}>{error.api}</div>}

        {response && (
          <div style={successCard}>
            <h4>User Created</h4>
            <p><b>Username:</b> {response.username}</p>
            <p><b>Password:</b> {response.temporary_password}</p>
          </div>
        )}

      </div>
    </div>
  );
}

// ✅ Input Component
function Input({ label: lbl, name, value, onChange, error }) {
  return (
    <div style={field}>
      <label style={label}>{lbl}</label>
      <input
        name={name}
        value={value}
        onChange={onChange}
        style={{
          ...input,
          border: error ? "1px solid red" : input.border,
        }}
      />
      {error && <span style={errorText}>{error}</span>}
    </div>
  );
}

