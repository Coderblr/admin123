"use client";

import { useState } from "react";
import { styles } from "../../styles/AppStyles";

export default function CheckDigitEnquiryView() {
    const [server, setServer] = useState("");
    const [acc, setAcc] = useState("");

    const [loading, setLoading] = useState(false);
    const [response, setResponse] = useState(null);
    const [error, setError] = useState(null);
    const [formErrors, setFormErrors] = useState({});

    const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

    // =====================================================
    // Validation
    // =====================================================
    const validateForm = () => {
        const errors = {};

        // Server Validation
        if (!server) {
            errors.server = "Please select server";
        }

        // Account Validation
        if (!acc) {
            errors.acc = "Account number is required";
        } 
        else if (!/^\d+$/.test(acc)) {
            errors.acc = "Only numeric digits allowed";
        } 
        else if (acc.length !== 10) {
            errors.acc = "Account number must be exactly 10 digits";
        }

        setFormErrors(errors);

        return Object.keys(errors).length === 0;
    };

    // =====================================================
    // Submit Handler
    // =====================================================
    const handleSubmit = async (event) => {
        event.preventDefault();

        if (!validateForm()) {
            return;
        }

        setLoading(true);
        setError(null);
        setResponse(null);

        try {
            const payload = {
                server: server,
                acc: acc,
            };

            const res = await fetch(`${BASE_URL}/check_digit_enq`, {
                method: "POST",
                credentials: "include",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(payload),
            });

            // ============================================
            // Error Handling
            // ============================================
            if (!res.ok) {
                let errorMessage = `API Error ${res.status}`;

                try {
                    const errorData = await res.json();

                    errorMessage =
                        errorData.detail ||
                        errorData.message ||
                        errorMessage;
                } catch {
                    errorMessage = `${res.status} ${res.statusText}`;
                }

                throw new Error(errorMessage);
            }

            // ============================================
            // Parse Response
            // ============================================
            const data = await res.json();

            console.log("API Response:", data);

            setResponse(data);

        } catch (err) {
            console.error("API Error:", err);

            setError(
                err.message ||
                "Something went wrong while checking digit"
            );
        } finally {
            setLoading(false);
        }
    };

    // =====================================================
    // Extract Full Account Number
    // =====================================================
    const fullAccountNumber =
        response?.parsed?.account_no || "N/A";

    const checkDigit =
        fullAccountNumber !== "N/A"
            ? fullAccountNumber.split("-")[1]
            : "N/A";

    return (
        <div>

            {/* ========================================= */}
            {/* Header */}
            {/* ========================================= */}
            <div style={styles.pageHeader}>
                <div>
                    <h1 style={styles.pageTitle}>
                        Check Digit Enquiry
                    </h1>

                    <p style={styles.pageSubtitle}>
                        Validate and Generate Check Digit
                    </p>
                </div>
            </div>

            {/* ========================================= */}
            {/* Form Section */}
            {/* ========================================= */}
            <div style={styles.formCard}>
                <form onSubmit={handleSubmit}>

                    <div style={styles.formGrid}>

                        {/* ================================= */}
                        {/* Server */}
                        {/* ================================= */}
                        <div style={styles.formGroup}>
                            <label style={styles.label}>
                                Server
                            </label>

                            <select
                                value={server}
                                onChange={(e) => {
                                    setServer(e.target.value);

                                    setFormErrors({
                                        ...formErrors,
                                        server: "",
                                    });
                                }}
                                style={styles.select}
                                required
                            >
                                <option value="">
                                    Select Server
                                </option>

                                <option value="K">
                                    K
                                </option>

                                <option value="UAT">
                                    UAT
                                </option>

                                <option value="PROD">
                                    PROD
                                </option>
                            </select>

                            {formErrors.server && (
                                <div style={styles.fieldError}>
                                    {formErrors.server}
                                </div>
                            )}
                        </div>

                        {/* ================================= */}
                        {/* Account Number */}
                        {/* ================================= */}
                        <div style={styles.formGroup}>
                            <label style={styles.label}>
                                10 Digit Account Number
                            </label>

                            <input
                                type="text"
                                value={acc}
                                placeholder="Enter 10 Digit Account Number"
                                style={styles.input}
                                maxLength={10}
                                required
                                onChange={(e) => {

                                    const value = e.target.value;

                                    // Numeric validation
                                    if (!/^\d*$/.test(value)) {

                                        setFormErrors({
                                            ...formErrors,
                                            acc:
                                                "Only numeric digits allowed",
                                        });

                                        return;
                                    }

                                    setAcc(value);

                                    // Real Time Validation
                                    if (value.length > 0 && value.length < 10) {

                                        setFormErrors({
                                            ...formErrors,
                                            acc:
                                                "Account number must be exactly 10 digits",
                                        });

                                    } else {

                                        setFormErrors({
                                            ...formErrors,
                                            acc: "",
                                        });
                                    }
                                }}
                            />

                            {formErrors.acc && (
                                <div style={styles.fieldError}>
                                    {formErrors.acc}
                                </div>
                            )}
                        </div>
                    </div>

                    {/* ================================= */}
                    {/* Submit Button */}
                    {/* ================================= */}
                    <button
                        type="submit"
                        style={styles.primaryButton}
                        disabled={loading}
                    >
                        {loading
                            ? "Checking..."
                            : "Generate Check Digit"}
                    </button>
                </form>
            </div>

            {/* ========================================= */}
            {/* Error Section */}
            {/* ========================================= */}
            {error && (
                <div style={styles.resultsCard}>
                    <div style={styles.errorMsg}>
                        <strong>Error:</strong> {error}
                    </div>
                </div>
            )}

            {/* ========================================= */}
            {/* Response Section */}
            {/* ========================================= */}
            {response && (
                <div style={styles.resultsCard}>

                    <h3 style={{ marginBottom: "20px" }}>
                        Check Digit Result
                    </h3>

                    <div style={styles.resultsList}>

                        <div style={styles.resultItem}>

                            <div style={styles.resultContent}>

                                {/* Status */}
                                <p>
                                    <strong>Status:</strong>{" "}
                                    {response?.parsed?.status || "N/A"}
                                </p>

                                {/* Original Account */}
                                <p>
                                    <strong>Entered Account Number:</strong>{" "}
                                    {acc}
                                </p>

                                {/* Check Digit */}
                                <p>
                                    <strong>Generated Check Digit:</strong>{" "}
                                    {checkDigit}
                                </p>

                                {/* Full Account Number */}
                                <p
                                    style={{
                                        fontSize: "18px",
                                        fontWeight: "bold",
                                        color: "#0f766e",
                                        marginTop: "15px",
                                    }}
                                >
                                    <strong>
                                        Full Account Number:
                                    </strong>{" "}
                                    {fullAccountNumber}
                                </p>

                                {/* ================================= */}
                                {/* Raw API Response */}
                                {/* ================================= */}
                                <div style={{ marginTop: "20px" }}>

                                    <p>
                                        <strong>
                                            Raw API Response
                                        </strong>
                                    </p>

                                    <pre
                                        style={{
                                            background: "#f4f4f4",
                                            padding: "12px",
                                            borderRadius: "8px",
                                            overflowX: "auto",
                                            fontSize: "12px",
                                            marginTop: "10px",
                                            maxHeight: "400px",
                                        }}
                                    >
                                        {JSON.stringify(
                                            response,
                                            null,
                                            2
                                        )}
                                    </pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}